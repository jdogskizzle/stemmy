# Copy to .env and edit.

# First-run admin account (only used when the database has no users yet).
STEMMY_ADMIN_USERNAME=admin
STEMMY_ADMIN_PASSWORD=change-me

# Where songs and the database live on the host.
STEMMY_DATA_DIR=./data
# UID/GID that owns STEMMY_DATA_DIR (run `id` to find yours).
PUID=1000
PGID=1000

# HTTPS: set to your domain (e.g. music.example.com) for automatic Let's Encrypt certificates.
# The domain's DNS must point at this server and ports 80 + 443 must be forwarded to it.
# Leave as :80 for plain HTTP on your LAN, or when another proxy/tunnel terminates TLS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Serve under a sub-path (e.g. /stemmy) when another reverse proxy routes by path and strips the prefix.
# Leave empty to serve at the root of the domain.
STEMMY_BASE_PATH=

STEMMY_TOKEN_TTL_DAYS=30
STEMMY_MAX_UPLOAD_MB=1024
